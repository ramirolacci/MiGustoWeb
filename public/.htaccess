# SPA en subcarpeta /tools/remastered/ (React Router + Vite)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tools/remastered/

  # Archivos y carpetas reales (assets, images, models, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta (/productos2, /sucursales, ...) -> index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs)$">
    Header set Content-Type "application/javascript; charset=utf-8"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html
